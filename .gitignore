# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# Environments
.venv/
venv/

# Secrets / credentials (never commit)
.env
.env.*
*.key
*.pem
secrets.*
kaggle.json
credentials*.json

# Data, models and generated outputs (large / reproducible from scripts)
data/*
!data/.gitkeep
models/
runs/
results/*
!results/.gitkeep
!results/*.md
!results/*.csv
!results/*.json
!results/*.png
# figures that contain ZooLake images (unclear license -> not redistributed)
results/preprocess_comparison.png
results/synthetic_examples.png
results/pipeline_example*.png
# per-image prediction dumps (large, contain dataset file paths only - regenerable)
results/*_predictions.csv
*.pt
*.pth
*.onnx
*.zip
*.tar
*.tar.gz

# Ultralytics default output folder
yolov8*.pt
ultralytics_runs/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
!results/v1/
results/v1/*_predictions.csv
# app/CLI analysis history (SQLite + per-analysis outputs; may contain user images)
results/history/

# Frontend (React + Vite): dependencies and build output are regenerated by npm
frontend/node_modules/
frontend/dist/
# Hallmark render screenshots (regenerated by sloplint)
.hallmark/shots/

# Hallmark tool logs
.hallmark/
frontend/.hallmark/
